# Copy to .env and fill in values. make test never reads this file directly —
# it must pass with none of these set. See CLAUDE.md's config table for what
# each variable controls and its default.

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_EXTRACTION_MODEL= # default: google/gemma-4-26b-a4b-it:free (DEC-013)
FLEET_DB_PATH=
FLEET_SPEED_MULTIPLIER=
AGENT_ENABLED=
AGENT_MAX_STEPS=
AGENT_MAX_CONCURRENT_TRIAGE=
EXTRACTION_CONFIDENCE_THRESHOLD=
PENDING_ACTION_TTL_SECONDS=
SEVERITY_WEIGHTS=
AGING_RATE=
OPERATOR_ID=
FLEET_GRAPHQL_URL= # default: http://localhost:8080/query (OQ-16)
AGENT_BASE_URL= # default: http://localhost:8081 (DEC-042)
WEB_PORT= # default: 5173 (Vite default, not forced)
POLL_INTERVAL_MS= # default: 5000 (OQ-16)
# web/ (Vite) only reads VITE_-prefixed vars at build/runtime; set these to the
# same values as their non-prefixed counterparts above when running web/ standalone.
VITE_FLEET_GRAPHQL_URL=
VITE_AGENT_BASE_URL=
VITE_POLL_INTERVAL_MS=
